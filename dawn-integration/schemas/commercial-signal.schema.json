{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawn.local/schemas/commercial-signal-v1.json",
  "title": "DAWN Commercial Signal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signal_id", "account", "signal_type", "observed_at", "source", "summary", "confidence", "recommended_use", "external_actions_performed"],
  "properties": {
    "schema_version": {"const": 1},
    "signal_id": {"type": "string", "pattern": "^SIG-[A-Z0-9-]{6,80}$"},
    "account": {"type": "string", "minLength": 1, "maxLength": 300},
    "signal_type": {"enum": ["company-event", "executive-change", "financial-pressure", "cyber-incident", "government-contract", "supply-chain-event", "infrastructure-event", "news-convergence"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "retrieved_at"],
      "properties": {
        "name": {"type": "string", "maxLength": 300},
        "url": {"type": "string", "format": "uri", "maxLength": 2000},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    },
    "summary": {"type": "string", "minLength": 20, "maxLength": 5000},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "recommended_use": {"enum": ["research-only", "meeting-preparation", "account-prioritisation", "draft-outreach-angle"]},
    "evidence_refs": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 2000}},
    "warnings": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
    "external_actions_performed": {"const": false}
  }
}
